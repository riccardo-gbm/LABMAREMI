# Shipped to the browser (Vite only exposes VITE_-prefixed vars).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Local-only, used by scripts/*.mjs to write the catalog. NOT VITE_-prefixed,
# so these never reach the browser bundle. Provide EITHER the service role key
# OR an admin login — not both needed.
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Local-only, used by scripts/test-quote-notification.mjs. Must equal the value
# in private.notification_config.shared_secret (migration 0007) and the
# QUOTE_NOTIFICATION_SECRET function secret. Never VITE_-prefixed.
# QUOTE_NOTIFICATION_SECRET=

# The quote-notification Edge Function's own env (RESEND_API_KEY,
# QUOTE_NOTIFICATION_FROM, QUOTE_NOTIFICATION_RECIPIENTS, QUOTE_ADMIN_URL) does
# NOT live here — it is set with `supabase secrets set`. See docs/RUNBOOK.md §3.
