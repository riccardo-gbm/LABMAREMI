# Supabase CLI local state (created by `supabase link`).
# Scoped to .temp deliberately: this used to be a bare `supabase`, which ignored
# the whole directory — migrations and Edge Functions included. That is why
# 0006_admin_role_rls.sql existed on disk but never in git, and why the docs
# carried a note about it being "missing from the repo". Everything else under
# supabase/ is source and must be tracked.
supabase/.temp

# Source art for scripts/optimize-images.mjs. Not tracked: these are the same
# base64-in-SVG files this branch removes from public/, so they already live in
# git history. Recover one with:
#   git show <commit-before-this-branch>:public/photo4.svg > design-assets/originals/photo4.svg
design-assets
description.txt
.graphifyignore

